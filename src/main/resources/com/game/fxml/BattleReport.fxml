<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="reportRoot" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.game.controller.BattleReportController" spacing="15">

    <Button text="ПОКАЗАТИ РЕЗУЛЬТАТИ БОЮ" onAction="#handleShowReport" prefWidth="300"/>

    <TextArea fx:id="reportTextArea" editable="false" prefHeight="400.0" prefWidth="600.0"/>

    <Button text="Повернутися в Меню" onAction="#handleReturnToMenu"/>

</VBox>
