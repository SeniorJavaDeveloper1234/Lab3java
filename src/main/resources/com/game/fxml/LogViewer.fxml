<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="reportRoot" alignment="CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.game.controller.LogViewerController"
      prefHeight="500.0" prefWidth="700.0">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="ПЕРЕГЛЯД ЛОГІВ БОЮ" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Button text="ОБРАТИ ФАЙЛ ЛОГУ" onAction="#handleChooseFile" prefWidth="250"/>

    <TextArea fx:id="logTextArea"
              editable="false"
              prefHeight="400.0"
              VBox.vgrow="ALWAYS" /> <Button text="Повернутися в Меню" onAction="#handleReturnToMenu"/>

</VBox>